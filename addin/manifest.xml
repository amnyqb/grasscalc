<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
    xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
    xmlns:ovr="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
    xsi:type="TaskPaneApp">

  <!-- Sideload-only id; replace with a real GUID before submitting to AppSource. -->
  <Id>e2c9f1b0-8d4a-4c2e-9d77-c4a1c9b1e4a0</Id>
  <Version>0.1.0</Version>
  <ProviderName>Chartsmith</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Chartsmith"/>
  <Description DefaultValue="Author publication-quality charts in PowerPoint, styled by your design system."/>
  <IconUrl DefaultValue="https://localhost:3000/assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://localhost:3000/assets/icon-80.png"/>
  <SupportUrl DefaultValue="https://localhost:3000/"/>

  <AppDomains>
    <AppDomain>https://localhost:3000</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Presentation"/>
  </Hosts>

  <DefaultSettings>
    <SourceLocation DefaultValue="https://localhost:3000/taskpane.html"/>
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>

  <VersionOverrides
      xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
      xsi:type="VersionOverridesV1_0">

    <Hosts>
      <Host xsi:type="Presentation">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title"/>
            <Description resid="GetStarted.Description"/>
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl"/>
          </GetStarted>

          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <CustomTab id="Chartsmith.Tab">
              <Group id="Chartsmith.Group">
                <Label resid="Chartsmith.GroupLabel"/>
                <Icon>
                  <bt:Image size="16" resid="Chartsmith.Icon16"/>
                  <bt:Image size="32" resid="Chartsmith.Icon32"/>
                  <bt:Image size="80" resid="Chartsmith.Icon80"/>
                </Icon>

                <Control xsi:type="Button" id="Chartsmith.OpenTaskPane">
                  <Label resid="Chartsmith.OpenTaskPane.Label"/>
                  <Supertip>
                    <Title resid="Chartsmith.OpenTaskPane.Label"/>
                    <Description resid="Chartsmith.OpenTaskPane.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Chartsmith.Icon16"/>
                    <bt:Image size="32" resid="Chartsmith.Icon32"/>
                    <bt:Image size="80" resid="Chartsmith.Icon80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>Chartsmith.Taskpane</TaskpaneId>
                    <SourceLocation resid="Chartsmith.Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
              <Label resid="Chartsmith.TabLabel"/>
            </CustomTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="Chartsmith.Icon16" DefaultValue="https://localhost:3000/assets/icon-16.png"/>
        <bt:Image id="Chartsmith.Icon32" DefaultValue="https://localhost:3000/assets/icon-32.png"/>
        <bt:Image id="Chartsmith.Icon80" DefaultValue="https://localhost:3000/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="https://localhost:3000/"/>
        <bt:Url id="Chartsmith.Taskpane.Url" DefaultValue="https://localhost:3000/taskpane.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GetStarted.Title" DefaultValue="Chartsmith"/>
        <bt:String id="Chartsmith.TabLabel" DefaultValue="Chartsmith"/>
        <bt:String id="Chartsmith.GroupLabel" DefaultValue="Charts"/>
        <bt:String id="Chartsmith.OpenTaskPane.Label" DefaultValue="Open"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="GetStarted.Description" DefaultValue="Author publication-quality charts using a design system."/>
        <bt:String id="Chartsmith.OpenTaskPane.Tooltip" DefaultValue="Open the Chartsmith task pane to author or edit a chart."/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
