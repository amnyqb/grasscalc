{
  "name": "chartsmith-mcp",
  "version": "0.1.0",
  "description": "MCP server that bridges Claude and high-quality charting libraries (d3) while applying a user-defined design system. Think-cell, but for AI.",
  "type": "module",
  "bin": {
    "chartsmith-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "addin:up": "node bin/addin-up.mjs",
    "addin:certs": "office-addin-dev-certs install",
    "gallery": "node docs/gallery/build.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "d3": "^7.9.0",
    "fast-xml-parser": "^5.7.2",
    "jsdom": "^25.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/d3": "^7.4.3",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.7.5",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18"
  }
}
